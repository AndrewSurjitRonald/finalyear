# CoFound AI Environment Variables
PROJECT_NAME="CoFound AI"
PROJECT_DESCRIPTION="Explainable Team Chemistry and Intelligent Recommendation System"
VERSION="1.0.0"

# Database connection string (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./cofound.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/cofound_db"

# JWT Security
JWT_SECRET="super-secret-cofound-ai-jwt-key-2026-production-ready"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URLs & CORS
VITE_API_URL="http://localhost:8000/api/v1"
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
